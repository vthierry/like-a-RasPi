#!/usr/bin/env xdg-open

[Desktop Entry]
Version=1.0
Name=Thunderbird
GenericName=Email
Exec=thunderbird %u
TryExec=thunderbird
Icon=/usr/share/icons/HighContrast/scalable/actions/mail-message-new.svg
Terminal=false
Type=Application
StartupWMClass=Thunderbird-bin
MimeType=message/rfc822;x-scheme-handler/mailto;
StartupNotify=true
Categories=Network;Email;
X-Desktop-File-Install-Version=0.18
Name[en_US]=Mail
