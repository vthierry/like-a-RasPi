#!/usr/bin/env xdg-open

[Desktop Entry]
Version=1.0
Type=Application
Terminal=false
Icon[en_US]=/usr/share/icons/oxygen/32x32/actions/system-suspend-hibernate.png
Name[en_US]=hibernate
Exec=xterm -e sh -c 'sudo /usr/sbin/pm-hibernate'
Name=hibernate
Icon=/usr/share/icons/oxygen/32x32/actions/system-suspend-hibernate.png
