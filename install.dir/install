#!/bin/bash

# Usage: Installs a RasPi-like light environment on Ubuntu or other Linux distributions

confirm() {
  read -p "$1? (y/N) : " -n 1 -e rep ; if [ "$rep" = "y" ] ; then true ; else if [ \! -z "$exit_message" ] ; then echo -e "$exit_message" ; exit 1 ; fi ; false ; fi
}

## 1/ Performs installations if needed
mkdir /tmp/install$$ ; cd /tmp/install$$
### Installs mate and complement if not yet done
sudo apt update
for f in wget ubuntu-mate-desktop speedtest-cli
do if ! apt -qq list $f 2>/dev/null | grep '\[installed' > /dev/null
then sudo apt install -qq -y 
fi ; done
#### The Ubuntu present version of lxterminal is behind the Raspi OS one, this will change in a near future
if [ "`lxterminal --version`" -ne "lxterminal 0.4.1" ]
then 
  wget -q http://fr.archive.ubuntu.com/ubuntu/pool/universe/l/lxterminal/lxterminal_0.4.1-1_amd64.deb
  sudo dpkg -i lxterminal*.deb
fi
#### The very nice peazip close to xarchive app is not in the apt bundle
if [ -z "`which peazip`" ]
then
  wget -q https://github.com/peazip/PeaZip/releases/download/11.3.0/peazip_11.3.0.LINUX.GTK2-1_amd64.deb
  sudo dpkg -i peazip*.deb
fi
### Installs the PiX theme
if [ \! -e "/usr/share/themes/PiX" ]
then
  wget -q https://github.com/b1ack0p/pixflat-theme/raw/main/packages/pool/themes/pix-theme_0.1_amd64.deb
  dpkg-deb -R $theme.deb . ; sudo cp -r usr/share/themes/PiX /usr/share/themes
fi
### Installs the PiX icons
if [ \! -e "/usr/share/icons/PiXtrix" ]
then
  wget -q https://github.com/b1ack0p/pixflat-theme/raw/main/packages/pool/icons/pixtrix-icons_0.6_all+debcompat.deb
  dpkg-deb -R $icons.deb . ; sudo cp -r usr/share/icons/PiX* /usr/share/icons
fi

## 2/ Installs local files
cd
wget -O /tmp/install$$/main.zip -q https://github.com/vthierry/like-a-RasPi/archive/refs/heads/main.zip
unzip -q -u /tmp/install$$/main.zip
./bin/findsubst -in "vthierry" -out "$USER"
sudo cp ~/.config/mimeinfo.cache /usr/share/applications/mimeinfo.cache

## 3/ Creates a /local/data directory to store data outside /home/$USER
if [ \! -e "/local/data" ]
then sudo mkdir -p /local/data ; sudo chown -R `whoami` /local/data ; sudo chgrp  -R `whoami` /local/data
fi

## 4/ Cleans and concludes
/bin/rm -rf /tmp/install$$
echo "Please follow https://github.com/vthierry/like-a-RasPi/blob/main/README.md"





